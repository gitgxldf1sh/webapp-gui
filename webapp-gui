def _system_language() -> str:
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(var, "")
        for code in val.split(":"):
            code = code.split(".")[0].split("_")[0].lower()
            if code and code not in ("c", "posix"):
                return code
    return "en"


_STRINGS = TRANSLATIONS.get(_system_language(), {})


def _(text: str) -> str:
    return _STRINGS.get(text, text)

# Orden de preferencia: el primero instalado es el predeterminado.
# Solo navegadores basados en Chromium: son los únicos con modo --app.
KNOWN_BROWSERS = [
    "brave-origin-nightly",
    "helium-browser",
    "google-chrome-stable",
    "google-chrome",
    "chromium",
    "brave",
    "brave-browser",
